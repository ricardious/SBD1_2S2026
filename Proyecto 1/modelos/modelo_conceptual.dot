graph conceptual {
  graph [
    layout=neato,
    bgcolor="white",
    pad=0.30,
    splines=line,
    overlap=false,
    outputorder=edgesfirst,
    fontname="DejaVu Sans"
  ];

  node [
    shape=ellipse,
    style=filled,
    fontcolor="#172033",
    fontname="DejaVu Sans Bold",
    fontsize=11,
    penwidth=1.35,
    margin="0.16,0.10",
    pin=true
  ];

  edge [
    color="#64748B",
    penwidth=1.25
  ];

  PAIS [pos="75,700!", fillcolor="#DCEBFF", color="#5B8DEF"];
  DEPARTAMENTO [pos="75,610!", fillcolor="#DCEBFF", color="#5B8DEF"];
  MUNICIPIO [pos="75,520!", fillcolor="#DCEBFF", color="#5B8DEF"];

  TIPO_TIENDA [pos="300,700!", fillcolor="#EEE7FF", color="#8B5CF6"];
  TIENDA [pos="300,600!", fillcolor="#EEE7FF", color="#8B5CF6"];
  PERSONA [pos="300,350!", fillcolor="#EEE7FF", color="#8B5CF6"];
  EMPLEADO [pos="470,400!", fillcolor="#EEE7FF", color="#8B5CF6"];
  CLIENTE [pos="470,250!", fillcolor="#EEE7FF", color="#8B5CF6"];
  CARGO [pos="470,500!", fillcolor="#EEE7FF", color="#8B5CF6"];
  TIPO_IDENTIFICACION [pos="470,145!", fillcolor="#EEE7FF", color="#8B5CF6"];

  CATEGORIA [pos="700,760!", fillcolor="#DFF8F7", color="#1AA6A6"];
  MARCA [pos="850,760!", fillcolor="#DFF8F7", color="#1AA6A6"];
  PRODUCTO [pos="775,660!", fillcolor="#DFF8F7", color="#1AA6A6"];
  CATALOGO_PRODUCTO [pos="520,700!", fillcolor="#E5F4E7", color="#67A96B"];

  DETALLE_VENTA [pos="775,560!", fillcolor="#E5F4E7", color="#67A96B"];
  VENTA [pos="700,500!", fillcolor="#FFF0D8", color="#E6A23C"];
  ESTADO_VENTA [pos="865,500!", fillcolor="#FFF0D8", color="#E6A23C"];
  PAGO [pos="700,300!", fillcolor="#FFF0D8", color="#E6A23C"];
  METODO_PAGO [pos="865,300!", fillcolor="#FFF0D8", color="#E6A23C"];

  PAIS -- DEPARTAMENTO;
  DEPARTAMENTO -- MUNICIPIO;
  MUNICIPIO -- TIENDA;
  MUNICIPIO -- PERSONA;

  TIPO_TIENDA -- TIENDA;
  PERSONA -- EMPLEADO;
  PERSONA -- CLIENTE;
  TIENDA -- EMPLEADO;
  CARGO -- EMPLEADO;
  TIPO_IDENTIFICACION -- CLIENTE;

  CATEGORIA -- PRODUCTO;
  MARCA -- PRODUCTO;
  TIENDA -- CATALOGO_PRODUCTO;
  PRODUCTO -- CATALOGO_PRODUCTO;

  TIENDA -- VENTA;
  EMPLEADO -- VENTA;
  CLIENTE -- VENTA;
  ESTADO_VENTA -- VENTA;
  VENTA -- DETALLE_VENTA;
  PRODUCTO -- DETALLE_VENTA;
  VENTA -- PAGO;
  METODO_PAGO -- PAGO;
}
