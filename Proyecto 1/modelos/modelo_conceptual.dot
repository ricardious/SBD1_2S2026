graph conceptual {
  graph [
    layout=neato,
    bgcolor="white",
    pad=0.30,
    splines=line,
    overlap=false,
    outputorder=edgesfirst,
    fontname="DejaVu Sans"
  ];

  node [
    shape=ellipse,
    style=filled,
    fontcolor="#172033",
    fontname="DejaVu Sans Bold",
    fontsize=11,
    penwidth=1.35,
    margin="0.16,0.10",
    pin=true
  ];

  edge [
    color="#64748B",
    penwidth=1.25
  ];

  PAIS [pos="75,690!", fillcolor="#DCEBFF", color="#5B8DEF"];
  DEPARTAMENTO [pos="75,590!", fillcolor="#DCEBFF", color="#5B8DEF"];
  MUNICIPIO [pos="75,490!", fillcolor="#DCEBFF", color="#5B8DEF"];

  TIPO_TIENDA [pos="270,690!", fillcolor="#EEE7FF", color="#8B5CF6"];
  TIENDA [pos="270,590!", fillcolor="#EEE7FF", color="#8B5CF6"];
  PERSONA [pos="270,410!", fillcolor="#EEE7FF", color="#8B5CF6"];
  EMPLEADO [pos="465,485!", fillcolor="#EEE7FF", color="#8B5CF6"];
  CLIENTE [pos="465,365!", fillcolor="#EEE7FF", color="#8B5CF6"];
  CARGO [pos="465,590!", fillcolor="#EEE7FF", color="#8B5CF6"];
  TIPO_IDENTIFICACION [pos="465,255!", fillcolor="#EEE7FF", color="#8B5CF6"];

  CATEGORIA [pos="690,710!", fillcolor="#DFF8F7", color="#1AA6A6"];
  MARCA [pos="840,710!", fillcolor="#DFF8F7", color="#1AA6A6"];
  PRODUCTO [pos="765,610!", fillcolor="#DFF8F7", color="#1AA6A6"];
  CATALOGO_PRODUCTO [pos="505,650!", fillcolor="#E5F4E7", color="#67A96B"];

  DETALLE_VENTA [pos="765,500!", fillcolor="#E5F4E7", color="#67A96B"];
  VENTA [pos="690,385!", fillcolor="#FFF0D8", color="#E6A23C"];
  ESTADO_VENTA [pos="850,405!", fillcolor="#FFF0D8", color="#E6A23C"];
  PAGO [pos="690,225!", fillcolor="#FFF0D8", color="#E6A23C"];
  METODO_PAGO [pos="850,225!", fillcolor="#FFF0D8", color="#E6A23C"];

  PAIS -- DEPARTAMENTO;
  DEPARTAMENTO -- MUNICIPIO;
  MUNICIPIO -- TIENDA;
  MUNICIPIO -- PERSONA;

  TIPO_TIENDA -- TIENDA;
  PERSONA -- EMPLEADO;
  PERSONA -- CLIENTE;
  TIENDA -- EMPLEADO;
  CARGO -- EMPLEADO;
  TIPO_IDENTIFICACION -- CLIENTE;

  CATEGORIA -- PRODUCTO;
  MARCA -- PRODUCTO;
  TIENDA -- CATALOGO_PRODUCTO;
  PRODUCTO -- CATALOGO_PRODUCTO;

  TIENDA -- VENTA;
  EMPLEADO -- VENTA;
  CLIENTE -- VENTA;
  ESTADO_VENTA -- VENTA;
  VENTA -- DETALLE_VENTA;
  PRODUCTO -- DETALLE_VENTA;
  VENTA -- PAGO;
  METODO_PAGO -- PAGO;
}
