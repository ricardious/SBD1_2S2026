{
  "name": "comercial-la-estrella-api",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto Fase 2 - Bases de Datos 1",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "import:historico": "tsx scripts/import-historico.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.ts",
    "postman": "postman collection run postman/ComercialLaEstrella.postman_collection.json -e postman/local.postman_environment.json",
    "package": "python3 scripts/package.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mssql": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "postman-cli": "^1.75.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
